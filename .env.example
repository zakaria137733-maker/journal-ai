# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=  # Leave blank to auto-generate, or set a fixed 32+ char string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Vector DB (Qdrant Cloud) ──────────────────────────────────────────────────
# Create a free cluster at https://cloud.qdrant.io
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=journal_entries

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Switch between Ollama (local) and OpenRouter (cloud) by changing these three:
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=mistral

# For OpenRouter, swap to:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your-openrouter-key
# LLM_MODEL=anthropic/claude-3-haiku

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
